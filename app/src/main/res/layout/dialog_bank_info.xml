<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thiết lập thông tin ngân hàng để người khác có thể quét mã QR thanh toán cho bạn."
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp"/>

    <!-- Bank Spinner -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilBankName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ngân hàng"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_marginBottom="12dp">

        <AutoCompleteTextView
            android:id="@+id/spinnerBank"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:completionThreshold="1"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Account Number -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAccountNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Số tài khoản"
        style="@style/InputStyle"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAccountNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="20"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Account Holder -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAccountHolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tên chủ tài khoản (IN HOA, không dấu)"
        style="@style/InputStyle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAccountHolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:maxLength="50"/>
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
